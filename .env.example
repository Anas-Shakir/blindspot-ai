# ==============================================================================
# BLINDSPOT AI — Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' in your project root and replace placeholders with
# your actual credentials. Never commit your real '.env' file to version control.
# ==============================================================================

# ==============================================================================
# 1. AI REASONING & LLM ENGINE (Required)
# ==============================================================================
# Primary LLM provider for lecture planning, gap detection, student Q&A, and
# interactive whiteboard lesson generation.
# Get a free API key at: https://console.groq.com/keys
LLM_API_KEY=your_groq_api_key_here

# OpenAI-compatible API Endpoint (defaults to Groq LPU API)
LLM_BASE_URL=https://api.groq.com/openai/v1

# Foundation model identifier (verified Groq models: openai/gpt-oss-120b, openai/gpt-oss-20b, qwen/qwen3.8-27b)
LLM_MODEL=openai/gpt-oss-120b


# ==============================================================================
# 2. DATABASE CONFIGURATION (Supabase PostgreSQL / SQLite)
# ==============================================================================
# Option A: Supabase Connection Pooler (Recommended for production):
# In Supabase: Project Settings -> Database -> Connection string -> URI (Port 6543 or 5432)
# Note: Remove brackets from password; URL-encode special characters like '&' as '%26'.
# DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:6543/postgres?sslmode=require

# Option B: SQLite (Default local development, zero setup needed):
DATABASE_URL=sqlite:///./blindspot.db

# (Optional) Supabase API credentials if using Supabase Client SDK / Storage:
# SUPABASE_URL=https://your_project_ref.supabase.co
# SUPABASE_ANON_KEY=your_supabase_anon_key
# SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key


# ==============================================================================
# 3. CLOUDFLARE R2 OBJECT STORAGE (For lecture recordings & audio uploads)
# ==============================================================================
# Cloudflare R2 S3-compatible object storage credentials.
# Manage buckets & API tokens at: https://dash.cloudflare.com/
R2_ACCOUNT_ID=your_cloudflare_account_id_here
R2_ACCESS_KEY_ID=your_r2_access_key_id_here
R2_SECRET_KEY=your_r2_secret_access_key_here
R2_BUCKET_NAME=blindspot-storage


# ==============================================================================
# 4. WHATSAPP & ZERNIO INTEGRATION (Optional / Connected Learning Channel)
# ==============================================================================
# Zernio WhatsApp Business API credentials & webhook verification
ZERNIO_API_KEY=your_zernio_api_key_here
ZERNIO_BASE_URL=https://api.zernio.com/v1
ZERNIO_WEBHOOK_SECRET=your_webhook_secret_here
WHATSAPP_BUSINESS_NUMBER=+1234567890
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here
WHATSAPP_ENABLE_TTS=true
WHATSAPP_MAX_HISTORY_TURNS=8


# ==============================================================================
# 5. VOICE SYNTHESIS (TTS) & BACKEND PUBLIC URL
# ==============================================================================
# Default neural voice for spoken tutor explanations (Edge TTS)
EDGE_TTS_VOICE=en-US-ChristopherNeural
# Other options: en-US-GuyNeural, en-US-AriaNeural, en-GB-RyanNeural, ur-PK-AsadNeural

# Public URL used to serve generated audio whiteboard files
BACKEND_PUBLIC_URL=http://localhost:8000


# ==============================================================================
# 6. ALIBABA CLOUD / DASHSCOPE (Optional Extension)
# ==============================================================================
# Uncomment if using Alibaba DashScope for Qwen models or CosyVoice TTS:
# DASHSCOPE_API_KEY=your_dashscope_api_key_here
# ALIBABA_API_KEY=your_alibaba_api_key_here
# ALIBABA_TTS_VOICE=cosyvoice-v1


# ==============================================================================
# 7. FRONTEND CONFIGURATION (For frontend/.env.local or Vercel Environment Vars)
# ==============================================================================
# Base URL pointing to the FastAPI backend
NEXT_PUBLIC_API_URL=http://localhost:8000
